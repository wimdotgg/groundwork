{
  "permissions": {
    "allow": [
      "Bash(node scripts/agent/*)",
      "Bash(node scripts/human/*)",
      "Bash(node --test *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh issue status *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr status *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push origin main*)",
      "Bash(git push * main)",
      "Bash(git rebase*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit * --no-verify*)",
      "Bash(gh pr merge * --admin*)",
      "Bash(gh api -X DELETE *rulesets*)",
      "Bash(gh api -X PUT *rulesets*)",
      "Bash(gh api --method DELETE *rulesets*)",
      "Bash(gh api --method PUT *rulesets*)",
      "Bash(gh api -X DELETE *environments*)",
      "Bash(gh api -X PUT *environments*)",
      "Bash(gh api --method DELETE *environments*)",
      "Bash(gh api --method PUT *environments*)",
      "Bash(gh api -X DELETE *secrets*)",
      "Bash(gh api -X PUT *secrets*)",
      "Bash(gh api --method DELETE *secrets*)",
      "Bash(gh api --method PUT *secrets*)"
    ]
  }
}
