  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/agent/token.mjs exec -- node scripts/agent/checkpoint.mjs --auto"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/agent/token.mjs exec -- node scripts/agent/checkpoint.mjs --auto"
          }
        ]
      }
    ]
  }
