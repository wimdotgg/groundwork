      "Bash(gh api *environments* -XDELETE*)",
      "Bash(gh api *environments* -XPUT*)",
      "Bash(gh api *environments* --method DELETE*)",
      "Bash(gh api *environments* --method PUT*)",
      "Bash(gh api *environments* --method=DELETE*)",
      "Bash(gh api *environments* --method=PUT*)",
      "Bash(gh api *secrets* -X DELETE*)",
      "Bash(gh api *secrets* -X PUT*)",
      "Bash(gh api *secrets* -XDELETE*)",
      "Bash(gh api *secrets* -XPUT*)",
      "Bash(gh api *secrets* --method DELETE*)",
      "Bash(gh api *secrets* --method PUT*)",
