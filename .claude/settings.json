      "Bash(node scripts/agent/token.mjs exec -- git pull * --rebase*)",
      "Bash(node scripts/agent/token.mjs exec -- git * --no-verify*)",
      "Bash(node scripts/agent/token.mjs exec -- git commit -n*)",
      "Bash(node scripts/agent/token.mjs exec -- gh pr merge * --admin*)",
