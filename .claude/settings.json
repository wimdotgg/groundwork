      "Bash(gh api * -f *)",
      "Bash(gh api * -F *)",
      "Bash(gh api * --field *)",
      "Bash(gh api * --raw-field *)",
      "Bash(gh api * --input *)",
      "Bash(node scripts/agent/token.mjs exec -- git push --force*)",
      "Bash(node scripts/agent/token.mjs exec -- git push -f*)",
      "Bash(node scripts/agent/token.mjs exec -- git push * --force*)",
      "Bash(node scripts/agent/token.mjs exec -- git push * -f*)",
      "Bash(node scripts/agent/token.mjs exec -- git push origin main*)",
      "Bash(node scripts/agent/token.mjs exec -- git push * main)",
      "Bash(node scripts/agent/token.mjs exec -- git push * +*)",
      "Bash(node scripts/agent/token.mjs exec -- git push *:main*)",
