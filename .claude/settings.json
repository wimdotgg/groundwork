{
  "env": {
    "GH_CONFIG_DIR": ".claude/gh-agent",
    "GCM_INTERACTIVE": "never"
  },
  "permissions": {
    "allow": [
      "Bash(node scripts/agent/*)",
      "Bash(node scripts/human/*)",
      "Bash(node --test *)"
    ],
    "deny": [
      "Bash(gh)",
      "Bash(gh *)",
      "Bash(gh.exe)",
      "Bash(*gh.exe *)",
      "Bash(*/gh *)",
      "Bash(*token.mjs* exec -- gh auth*)",
      "Bash(*token.mjs* exec -- gh config set*)",
      "Bash(*token.mjs* exec -- gh alias set*)",
      "Bash(*token.mjs* exec -- gh alias import*)",
      "Bash(*token.mjs* exec -- gh extension*)",
      "Bash(*token.mjs* exec -- gh ext *)",
      "Bash(*token.mjs* exec -- gh extensions*)",
      "Bash(*token.mjs* exec -- gh copilot*)",
      "Bash(*token.mjs* exec -- gh aw*)",
      "Bash(*token.mjs* exec -- gh stack*)",
      "Bash(*token.mjs* exec -- gh webhook*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push origin main*)",
      "Bash(git push * main)",
      "Bash(git rebase*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit * --no-verify*)",
      "Bash(git push * +*)",
      "Bash(git push *:main*)",
      "Bash(git push *refs/heads/main*)",
      "Bash(git commit -n*)",
      "Bash(git * --no-verify*)",
      "Bash(git pull --rebase*)",
      "Bash(git pull * --rebase*)",
      "Bash(git -C * push * --force*)",
      "Bash(git -C * push * -f*)",
      "Bash(git push*)",
      "Bash(git -C * push*)",
      "Bash(*token.mjs* exec -- git push --force*)",
      "Bash(*token.mjs* exec -- git push -f*)",
      "Bash(*token.mjs* exec -- git push * --force*)",
      "Bash(*token.mjs* exec -- git push * -f*)",
      "Bash(*token.mjs* exec -- git push origin main*)",
      "Bash(*token.mjs* exec -- git push * main)",
      "Bash(*token.mjs* exec -- git push * +*)",
      "Bash(*token.mjs* exec -- git push *:main*)",
      "Bash(*token.mjs* exec -- git push *refs/heads/main*)",
      "Bash(*token.mjs* exec -- git rebase*)",
      "Bash(*token.mjs* exec -- git pull --rebase*)",
      "Bash(*token.mjs* exec -- git pull * --rebase*)",
      "Bash(*token.mjs* exec -- git * --no-verify*)",
      "Bash(*token.mjs* exec -- git commit -n*)",
      "Bash(*token.mjs* exec -- git -C * push * --force*)",
      "Bash(*token.mjs* exec -- git -C * push * -f*)",
      "Bash(*token.mjs* exec -- git -C * push --force*)",
      "Bash(*token.mjs* exec -- git -C * push -f*)",
      "Bash(*token.mjs* exec -- git -C * push origin main*)",
      "Bash(*token.mjs* exec -- git -C * push * main)",
      "Bash(*token.mjs* exec -- git -C * push * +*)",
      "Bash(*token.mjs* exec -- git -C * push *:main*)",
      "Bash(*token.mjs* exec -- git -C * push *refs/heads/main*)",
      "Bash(*token.mjs* exec -- gh pr merge * --admin*)",
      "Bash(*token.mjs* exec -- gh pr merge --admin*)",
      "Bash(*token.mjs* exec -- gh api *rulesets* -X *)",
      "Bash(*token.mjs* exec -- gh api *rulesets* --method *)",
      "Bash(*token.mjs* exec -- gh api *rulesets* -XDELETE*)",
      "Bash(*token.mjs* exec -- gh api *rulesets* -XPUT*)",
      "Bash(*token.mjs* exec -- gh api *rulesets* --method=DELETE*)",
      "Bash(*token.mjs* exec -- gh api *rulesets* --method=PUT*)",
      "Bash(*token.mjs* exec -- gh api *environments* -X *)",
      "Bash(*token.mjs* exec -- gh api *environments* --method *)",
      "Bash(*token.mjs* exec -- gh api *environments* -XDELETE*)",
      "Bash(*token.mjs* exec -- gh api *environments* -XPUT*)",
      "Bash(*token.mjs* exec -- gh api *environments* --method=DELETE*)",
      "Bash(*token.mjs* exec -- gh api *environments* --method=PUT*)",
      "Bash(*token.mjs* exec -- gh api *secrets* -X *)",
      "Bash(*token.mjs* exec -- gh api *secrets* --method *)",
      "Bash(*token.mjs* exec -- gh api *secrets* -XDELETE*)",
      "Bash(*token.mjs* exec -- gh api *secrets* -XPUT*)",
      "Bash(*token.mjs* exec -- gh api *secrets* --method=DELETE*)",
      "Bash(*token.mjs* exec -- gh api *secrets* --method=PUT*)",
      "Bash(*token.mjs* exec -- gh api *rulesets* -X*)",
      "Bash(*token.mjs* exec -- gh api *rulesets* --method*)",
      "Bash(*token.mjs* exec -- gh api -X* *rulesets*)",
      "Bash(*token.mjs* exec -- gh api --method* *rulesets*)",
      "Bash(*token.mjs* exec -- gh api * -X* *rulesets*)",
      "Bash(*token.mjs* exec -- gh api * --method* *rulesets*)",
      "Bash(*token.mjs* exec -- gh api *rulesets* -iX*)",
      "Bash(*token.mjs* exec -- gh api -iX* *rulesets*)",
      "Bash(*token.mjs* exec -- gh api * -iX* *rulesets*)",
      "Bash(*token.mjs* exec -- gh api *environments* -X*)",
      "Bash(*token.mjs* exec -- gh api *environments* --method*)",
      "Bash(*token.mjs* exec -- gh api -X* *environments*)",
      "Bash(*token.mjs* exec -- gh api --method* *environments*)",
      "Bash(*token.mjs* exec -- gh api * -X* *environments*)",
      "Bash(*token.mjs* exec -- gh api * --method* *environments*)",
      "Bash(*token.mjs* exec -- gh api *environments* -iX*)",
      "Bash(*token.mjs* exec -- gh api -iX* *environments*)",
      "Bash(*token.mjs* exec -- gh api * -iX* *environments*)",
      "Bash(*token.mjs* exec -- gh api *secrets* -X*)",
      "Bash(*token.mjs* exec -- gh api *secrets* --method*)",
      "Bash(*token.mjs* exec -- gh api -X* *secrets*)",
      "Bash(*token.mjs* exec -- gh api --method* *secrets*)",
      "Bash(*token.mjs* exec -- gh api * -X* *secrets*)",
      "Bash(*token.mjs* exec -- gh api * --method* *secrets*)",
      "Bash(*token.mjs* exec -- gh api *secrets* -iX*)",
      "Bash(*token.mjs* exec -- gh api -iX* *secrets*)",
      "Bash(*token.mjs* exec -- gh api * -iX* *secrets*)",
      "Bash(*token.mjs* exec -- gh api *rulesets* -f*)",
      "Bash(*token.mjs* exec -- gh api *rulesets* -F*)",
      "Bash(*token.mjs* exec -- gh api *rulesets* --field*)",
      "Bash(*token.mjs* exec -- gh api *rulesets* --raw-field*)",
      "Bash(*token.mjs* exec -- gh api *rulesets* --input*)",
      "Bash(*token.mjs* exec -- gh api -f* *rulesets*)",
      "Bash(*token.mjs* exec -- gh api -F* *rulesets*)",
      "Bash(*token.mjs* exec -- gh api --field* *rulesets*)",
      "Bash(*token.mjs* exec -- gh api --raw-field* *rulesets*)",
      "Bash(*token.mjs* exec -- gh api --input* *rulesets*)",
      "Bash(*token.mjs* exec -- gh api *environments* -f*)",
      "Bash(*token.mjs* exec -- gh api *environments* -F*)",
      "Bash(*token.mjs* exec -- gh api *environments* --field*)",
      "Bash(*token.mjs* exec -- gh api *environments* --raw-field*)",
      "Bash(*token.mjs* exec -- gh api *environments* --input*)",
      "Bash(*token.mjs* exec -- gh api -f* *environments*)",
      "Bash(*token.mjs* exec -- gh api -F* *environments*)",
      "Bash(*token.mjs* exec -- gh api --field* *environments*)",
      "Bash(*token.mjs* exec -- gh api --raw-field* *environments*)",
      "Bash(*token.mjs* exec -- gh api --input* *environments*)",
      "Bash(*token.mjs* exec -- gh api *secrets* -f*)",
      "Bash(*token.mjs* exec -- gh api *secrets* -F*)",
      "Bash(*token.mjs* exec -- gh api *secrets* --field*)",
      "Bash(*token.mjs* exec -- gh api *secrets* --raw-field*)",
      "Bash(*token.mjs* exec -- gh api *secrets* --input*)",
      "Bash(*token.mjs* exec -- gh api -f* *secrets*)",
      "Bash(*token.mjs* exec -- gh api -F* *secrets*)",
      "Bash(*token.mjs* exec -- gh api --field* *secrets*)",
      "Bash(*token.mjs* exec -- gh api --raw-field* *secrets*)",
      "Bash(*token.mjs* exec -- gh api --input* *secrets*)",
      "Bash(*token.mjs* exec -- gh api * -f* *rulesets*)",
      "Bash(*token.mjs* exec -- gh api * -F* *rulesets*)",
      "Bash(*token.mjs* exec -- gh api * --field* *rulesets*)",
      "Bash(*token.mjs* exec -- gh api * --raw-field* *rulesets*)",
      "Bash(*token.mjs* exec -- gh api * --input* *rulesets*)",
      "Bash(*token.mjs* exec -- gh api * -f* *environments*)",
      "Bash(*token.mjs* exec -- gh api * -F* *environments*)",
      "Bash(*token.mjs* exec -- gh api * --field* *environments*)",
      "Bash(*token.mjs* exec -- gh api * --raw-field* *environments*)",
      "Bash(*token.mjs* exec -- gh api * --input* *environments*)",
      "Bash(*token.mjs* exec -- gh api * -f* *secrets*)",
      "Bash(*token.mjs* exec -- gh api * -F* *secrets*)",
      "Bash(*token.mjs* exec -- gh api * --field* *secrets*)",
      "Bash(*token.mjs* exec -- gh api * --raw-field* *secrets*)",
