{
  "schemaVersion": 1,
  "repository": {
    "visibility": "public",
    "has_issues": true,
    "has_projects": false,
    "has_wiki": false,
    "has_discussions": false,
    "allow_squash_merge": true,
    "allow_merge_commit": false,
    "allow_rebase_merge": false,
    "squash_merge_commit_title": "PR_TITLE",
    "squash_merge_commit_message": "BLANK",
    "allow_auto_merge": true,
    "delete_branch_on_merge": true,
    "allow_update_branch": true,
    "security_and_analysis": {
      "secret_scanning": { "status": "enabled" },
      "secret_scanning_push_protection": { "status": "enabled" }
    }
  },
  "controlRepository": {
    "is_template": true
  },
  "teamAccess": [
    { "team": "agents", "permission": "push" }
  ],
  "security": {
    "private_vulnerability_reporting": true,
    "vulnerability_alerts": true,
    "automated_security_fixes": true,
    "code_scanning_default_setup": { "state": "configured" }
  },
  "actions": {
    "permissions": {
      "enabled": true,
      "allowed_actions": "all",
      "sha_pinning_required": true
    },
    "workflow": {
      "default_workflow_permissions": "read",
      "can_approve_pull_request_reviews": false
    },
    "fork_pr_contributor_approval": {
      "approval_policy": "all_external_contributors"
    }
  },
  "variables": {
    "GROUNDWORK_READY": { "value": "true", "assertWhen": "kitInstalled" },
    "DEPLOY_ENABLED": { "value": "true", "assertWhen": "deployReady" }
  },
  "environments": {
    "release": {
      "repos": "all",
      "reviewers": [],
      "prevent_self_review": false,
      "can_admins_bypass": true,
      "deployment_refs": [ { "name": "main", "type": "branch" } ],
      "secrets": ["RELEASE_APP_KEY"],
      "variables": ["RELEASE_APP_CLIENT_ID"]
    },
    "production": {
      "repos": "projects",
      "reviewers": ["owner"],
      "prevent_self_review": false,
      "can_admins_bypass": false,
      "deployment_refs": [ { "name": "v*", "type": "tag" } ],
      "secrets": [],
      "variables": []
    },
    "admin": {
      "repos": "control",
      "reviewers": ["owner"],
      "prevent_self_review": false,
      "can_admins_bypass": false,
      "deployment_refs": [ { "name": "main", "type": "branch" } ],
      "secrets": ["ADMIN_APP_KEY", "RELEASE_APP_KEY"],
      "variables": ["ADMIN_APP_CLIENT_ID", "RELEASE_APP_CLIENT_ID"]
    }
  }
}
